{
  "entities": {
    "tasks": {
      "title": "Tasks",
      "description": "Portfolio tasks, practical and independent assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Task identifier" },
        "title": { "type": "string", "description": "Task title" },
        "number": { "type": "number", "description": "Task sequence number" },
        "topic": { "type": "string", "description": "Task theme / topic" },
        "category": { "type": "string", "description": "practical or independent" },
        "format": { "type": "string", "description": "pdf, word, pptx, zip, link, file" },
        "fileUrl": { "type": "string", "description": "Direct link to file" },
        "fileName": { "type": "string", "description": "Original file name" },
        "fileSize": { "type": "string", "description": "File size formatted" },
        "grade": { "type": "string", "description": "Grade or score" },
        "date": { "type": "string", "description": "Date formatted" },
        "completed": { "type": "boolean", "description": "Completed status" },
        "description": { "type": "string", "description": "Task description" },
        "link": { "type": "string", "description": "External task link" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Updated timestamp" }
      },
      "required": ["id", "title", "category"]
    },
    "profile": {
      "title": "Student Profile",
      "description": "Public student profile information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name" },
        "specialty": { "type": "string", "description": "Specialty" },
        "bio": { "type": "string", "description": "Bio description" },
        "city": { "type": "string", "description": "City" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "updatedAt": { "type": "string", "description": "Last updated" }
      },
      "required": ["fullName"]
    },
    "feedbacks": {
      "title": "Feedbacks",
      "description": "Visitor reviews, grades and comments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Feedback ID" },
        "senderName": { "type": "string", "description": "Author name" },
        "role": { "type": "string", "description": "Teacher, Student, Guest" },
        "message": { "type": "string", "description": "Feedback message" },
        "rating": { "type": "number", "description": "Star rating 1-5" },
        "createdAt": { "type": "string", "description": "Date created" }
      },
      "required": ["id", "senderName", "message", "rating"]
    },
    "task_files": {
      "title": "Task Files",
      "description": "Cross-user file payloads and base64 document contents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "File or Task ID" },
        "fileName": { "type": "string", "description": "Original file name" },
        "mimeType": { "type": "string", "description": "MIME type of file" },
        "fileData": { "type": "string", "description": "Base64 encoded dataURL" },
        "createdAt": { "type": "string", "description": "Upload timestamp" }
      },
      "required": ["id", "fileName", "fileData"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "tasks",
      "description": "Public collection storing practical and independent tasks"
    },
    "/profile/{docId}": {
      "schema": "profile",
      "description": "Student portfolio profile information"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "feedbacks",
      "description": "Teacher and visitor feedback entries"
    },
    "/task_files/{fileId}": {
      "schema": "task_files",
      "description": "Shared task documents accessible to any visitor"
    }
  }
}
