rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection: Anyone can read, anyone can create or modify
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Profile collection: Public read and write for portfolio owner
    match /profile/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Feedbacks & Comments collection: Visitors can read and post feedback
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if true;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection check
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

